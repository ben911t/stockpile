# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/
dist/
build/

# Config and secrets
config.toml
*.json
!config.toml.example
# Watchlists: one JSON per list. Personal lists stay local; only the
# shipped starter baskets are tracked.
options-scanner/watchlists/*.json
!options-scanner/watchlists/megacaps-watchlist.json
!options-scanner/watchlists/semiconductors.json
!options-scanner/watchlists/high-iv.json
!options-scanner/watchlists/index-etfs.json
.env

# Brokerage CSV exports
*.csv

# Brokerage exports, statements, and working notes — personal account data.
# Ignore EVERYTHING dropped into input/, keeping only the few files the repo
# ships. Previously just *.pdf and *.bak under here were ignored, so anything
# else (e.g. input/one_off/444_TODO.md) turned up as a commit candidate even
# though CLAUDE.md documents input/ as gitignored.
input/*
!input/.gitkeep
!input/README.md
!input/stockpile.csv.example

# Logs
*.log

# IDE
.idea/
.vscode/

# Tool output
charts/
output/
*.html
# Allow trading-dashboard templates to be tracked
!trading-dashboard/templates/
!trading-dashboard/templates/**
# Track the scanner trading test plan (interactive tracker, source of truth)
!options-scanner/TRADING_TEST_PLAN.html

# Scanner persistent cache (IV-history SQLite store, etc.)
cache/
options-scanner/cache/

# Assisted put-selling trade log (personal trade data)
options-scanner/trades/

# User preferences written by the ⚙️ Settings dialog (hidden positions, …)
options-scanner/settings/

# Images
*.png
*.jpg
*.jpeg
*.webp
*.xcf
*.gif
*.svg
# Per-app branding/static assets get tracked (overrides the blanket *.png etc.)
!options-scanner/assets/
!options-scanner/assets/**

# OS
.DS_Store
Thumbs.db

# Personal scratch / notes — never tracked
notes/

# Claude Code — local permission overrides (machine-specific paths and allows)
.claude/settings.local.json
# Claude Code — shared settings file (override the blanket *.json rule)
!.claude/settings.json
